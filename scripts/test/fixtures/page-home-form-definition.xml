<?xml version="1.0" encoding="UTF-8"?>
<form>
  <title>Home</title>
  <objectType>page</objectType>
  <content-type>/page/home</content-type>
  <sections>
    <section>
      <title>Page Properties</title>
      <fields>
        <field>
          <type>input</type>
          <id>title_t</id>
          <title>Title</title>
          <constraints>
            <constraint><name>required</name><value><![CDATA[true]]></value></constraint>
          </constraints>
        </field>
        <field>
          <type>input</type>
          <id>navLabel</id>
          <title>Nav Label</title>
        </field>
      </fields>
    </section>
    <section>
      <title>Hero Section</title>
      <fields>
        <field>
          <type>rte</type>
          <id>hero_title_html</id>
          <title>Hero Title</title>
          <constraints>
            <constraint><name>required</name><value><![CDATA[true]]></value></constraint>
          </constraints>
        </field>
        <field>
          <type>rte</type>
          <id>hero_text_html</id>
          <title>Hero Text</title>
        </field>
        <field>
          <type>image-picker</type>
          <id>hero_image_s</id>
          <title>Hero Image</title>
        </field>
      </fields>
    </section>
    <section>
      <title>Features</title>
      <fields>
        <field>
          <type>input</type>
          <id>features_title_t</id>
          <title>Features Title</title>
        </field>
        <field>
          <type>node-selector</type>
          <id>sections_o</id>
          <title>Sections</title>
        </field>
      </fields>
    </section>
  </sections>
</form>
